<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- App theme is driven by Compose (Material 3). This XML theme only styles the
         window before Compose takes over (no action bar, edge-to-edge friendly). -->
    <style name="Theme.ReadBridge" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
